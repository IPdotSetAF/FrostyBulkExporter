<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Small worker process that runs the native ealayer3.dll decoder for SoundEditorPlugin.
    A crash or hang inside the native decoder then only ends this process, never the editor.
    The exe is embedded into SoundEditorPlugin.dll (see SoundEditorPlugin.csproj) and extracted at run time.
    The output path does not depend on the configuration so SoundEditorPlugin can always find it.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>EALayer3Host</AssemblyTitle>
    <Product>EALayer3Host</Product>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
